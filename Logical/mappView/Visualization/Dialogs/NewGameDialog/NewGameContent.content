        <Widget xsi:type="widgets.brease.ToggleButton" id="EasyModeToggleBtn" top="0" left="0" width="200" height="40" zIndex="0" text="$IAT/Łatwy" style="Command" />
        <Widget xsi:type="widgets.brease.ToggleButton" id="HardModeToggleBtn" top="120" left="0" width="200" height="40" zIndex="1" text="$IAT/Ciężki" style="Command" />
