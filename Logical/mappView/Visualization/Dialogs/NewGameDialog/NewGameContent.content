<Content id="NewGameContent" guid="a9a54696-ec36-4d4c-a6e7-598f06504c47" height="300" width="500" xmlns="http://www.br-automation.com/iat2015/contentDefinition/v2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Widgets>
