    <Widget xsi:type="widgets.brease.Label" id="ChooseModeLb" top="20" left="260" width="200" zIndex="2" text="$IAT/Choose_mode" textColor="rgba(0, 0, 0, 1)" textAlign="center" bold="true" style="Title2" />
    <Widget xsi:type="widgets.brease.Label" id="ChooseColourLb" top="20" left="40" width="200" zIndex="3" text="$IAT/Choose_color" textColor="rgba(0, 0, 0, 1)" textAlign="center" bold="true" style="Title2" />
