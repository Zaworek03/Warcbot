<Content id="RRPContent" guid="4ecbaa9a-7b81-4f4f-ac0e-462424fcc0e6" height="200" width="400" xmlns="http://www.br-automation.com/iat2015/contentDefinition/v2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Widgets>
    <Widget xsi:type="widgets.brease.Label" id="Label1" top="20" left="20" width="360" height="100" zIndex="0" multiLine="true" text="Are you sure you want to reset the robot's position and start the game? Cancelation will abort the game." wordWrap="true" textAlign="center" style="Caption" />
    <Widget xsi:type="widgets.brease.Button" id="BtnAbort" top="130" left="20" width="160" height="50" zIndex="1" text="Cancel" style="Command" />
    <Widget xsi:type="widgets.brease.Button" id="BtnConfirm" top="130" left="220" width="160" height="50" zIndex="2" text="Confirm" style="Command" />
  </Widgets>
</Content>