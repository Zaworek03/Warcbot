<?xml version="1.0" encoding="utf-8"?>
<Content id="RulesContent" guid="dafc86c9-5b84-44f2-acde-a2c3818669b9" height="300" width="500" xmlns="http://www.br-automation.com/iat2015/contentDefinition/v2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Widgets>
    <Widget xsi:type="widgets.brease.Label" id="RulesLb" top="20" left="20" width="460" zIndex="0" text="Rules" textColor="rgba(0, 0, 0, 1)" textAlign="center" fontSize="30px" bold="true" style="Title1" />
    <Widget xsi:type="widgets.brease.Label" id="Label1" top="60" left="20" width="460" height="40" zIndex="1" multiLine="true" text="Checkers is played by two players on the dark squares of the board. One player uses dark pieces and moves first, then players take turns." wordWrap="true" textAlign="left top" style="tableConfigurationDialogStyle" />
    <Widget xsi:type="widgets.brease.Label" id="Label2" top="110" left="20" width="460" height="80" zIndex="2" multiLine="true" text="Pieces move diagonally forward by one square to an empty space. If an opponent's piece is on the adjacent diagonal square and the square behind it is empty, the piece must be captured by jumping over it. The captured piece is removed from the board." wordWrap="true" textAlign="left top" style="tableConfigurationDialogStyle" />
    <Widget xsi:type="widgets.brease.Label" id="Label3" top="190" left="20" width="460" height="60" zIndex="3" multiLine="true" text="If multiple captures are possible, they must be made according to the rules being used. A player loses if they have no pieces left or cannot make a legal move." wordWrap="true" textAlign="left top" style="tableConfigurationDialogStyle" />
    <Widget xsi:type="widgets.brease.Button" id="BackBtn" top="260" left="390" zIndex="4" text="Back" style="Command" />
  </Widgets>
</Content>