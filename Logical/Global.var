VAR
	gTest : BOOL;
	gMoveCounter : INT := 0;
	gPlayerColor : PlayerColorEnum;
	gDifficultyLevel : DifficultyLevelEnum;
	gGameState : GameStateEnum;
	gPieceType : PieceTypeEnum;
	gBoardBoard : ARRAY[1..8,1..8] OF PieceTypeEnum := [64(EMPTY)];
	gBoardPosition : ARRAY[1..8,1..8] OF PositionStruct;
	gWinner : WinnerEnum;
	gCurrentMove : MoveStruct;
	gVisionBoard : ARRAY[1..8,1..8] OF PieceTypeEnum;
	gGraStart : BOOL;
	gTrudnosc : USINT;
	gWyborPionkaBoard : ARRAY[0..7,0..7] OF USINT;
	gBoard : ARRAY[0..7,0..7] OF USINT;
	gJakiKolor : BOOL;
	bStartMove : BOOL;
	gPiece : PieceTypeEnum;
	gPickPiece : ARRAY[1..8,1..8] OF BOOL; (*Klikniety przez gracza pionek*)
	gEnableMove : ARRAY[1..8,1..8] OF BOOL; (*Mozliwe ruchy na szachownicy*)
	gPickMove : ARRAY[1..8,1..8] OF BOOL; (*Wybrany ruch przez gracza*)
	gBoardActual : ARRAY[1..8,1..8] OF INT; (*Aktualna plansza rozgrywki (0 puste pole, 1 biale, 2 czarne, 3 damka biale, 4 damka czarne)*)
	gGameRound : BOOL; (*False ruch robota, True ruch czlowieka*)
END_VAR
