VAR
	gAlarm : AlarmEnum;
	gGame : USINT;
	gTest : BOOL;
	gMoveCounter : INT := 0;
	gBoardBoard : ARRAY[1..8,1..8] OF PieceTypeEnum := [64(EMPTY)];
	gBoardPosition : ARRAY[1..8,1..8] OF PositionStruct;
	gCurrentMove : MoveStruct;
	gVisionBoard : ARRAY[1..8,1..8] OF PieceTypeEnum;
	gPickPiece : ARRAY[1..8,1..8] OF BOOL; (*Klikniety przez gracza pionek*)
	gEnableMove : ARRAY[1..8,1..8] OF BOOL; (*Mozliwe ruchy na szachownicy*)
	gPickMove : ARRAY[1..8,1..8] OF BOOL; (*Wybrany ruch przez gracza*)
	gBoardActual : ARRAY[1..8,1..8] OF USINT; (*Aktualna plansza rozgrywki (0 puste pole, 1 biale, 2 czarne, 3 damka biale, 4 damka czarne)*)
	gGameRound : BOOL; (*False ruch robota, True ruch czlowieka*)
	gPlayerColor : BOOL; (*True - biale, False - czarne*)
	gDifficultyLevel : USINT; (*0 - Easy, 1 - Medium, 2 - Hard*)
	gStart : BOOL; (*True - rozpocznij nowa gre, False - nic*)
	gEnablePiece : ARRAY[1..8,1..8] OF BOOL; (*Pionki mozliwe do klikniecia podczas tury*)
	gESTOP : USINT; (*Sygnal z sterownika Safety*)
	gStep : StepEnum; (*Maszyna stanow robota*)
END_VAR
