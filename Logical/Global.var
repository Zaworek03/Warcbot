VAR
	gCameraFocus : UINT := 53073;
	gCameraGainLevel : USINT := 4;
	gCameraExposureTime : UDINT := 20884;
	gAlarm : AlarmEnum;
	gGame : USINT;
	gPickPiece : ARRAY[1..8,1..8] OF BOOL; (*Klikniety przez gracza pionek*)
	gEnableMove : ARRAY[1..8,1..8] OF BOOL; (*Mozliwe ruchy na szachownicy*)
	gPickMove : ARRAY[1..8,1..8] OF BOOL; (*Wybrany ruch przez gracza*)
	gBoardActual : ARRAY[1..8,1..8] OF USINT; (*Aktualna plansza rozgrywki (0 puste pole, 1 biale, 2 czarne, 3 damka biale, 4 damka czarne)*)
	gGameRound : BOOL; (*False ruch robota, True ruch czlowieka*)
	gPlayerColor : BOOL; (*True - biale, False - czarne*)
	gDifficultyLevel : USINT; (*0 - Easy, 1 - Medium, 2 - Hard*)
	gStart : BOOL := FALSE; (*True - rozpocznij nowa gre, False - nic*)
	gEnablePiece : ARRAY[1..8,1..8] OF BOOL; (*Pionki mozliwe do klikniecia podczas tury*)
	gESTOP : BOOL; (*Sygnal z sterownika Safety*)
	gStep : StepEnum := Idle; (*Maszyna stanow robota*)
	gGameStats : GameStatStruct; (*Statystyki gry*)
	gCameraTrigger : BOOL;
	gBoardCamera : ARRAY[1..8,1..8] OF USINT;
	gCameraEnd : BOOL;
	gPlayerMove : BOOL;
	gStop : BOOL := TRUE; (*Odwrotnoœæ gStart*)
	New_Variable : USINT;
	gCameraAutoAdjust : BOOL;
	gCameraNumResults : USINT;
	gCameraBlackCount : USINT;
	gCameraWhiteCount : USINT;
	gCameraReadFocus : UINT;
	gCameraReadGainLevel : USINT;
	gCameraReadExposureTime : UDINT;
END_VAR
