(* Sterowanie robotem i homing *)
VAR
	RobotState : RobotStateType := ROBOT_DISABLED;
	mcGroupHome : MC_BR_GroupHome_15;
	AxisPos : ARRAY[0..5] OF REAL := [2(0),-90,3(0)];
	i : USINT;
END_VAR
(* Wymiana danych z ST Motion *)
VAR
	STMotionStartPoint : McPointType;
	STMotionEndPoint : McPointType;
	STMotionHomePoint : McPointType := (Pos:=(X:=222,Y:=-228,Z:=565),Orient:=(Angle1:=0,Angle2:=180,Angle3:=0));
	STMotionDone : BOOL := FALSE;
END_VAR
VAR CONSTANT
	STMotionDefaultOrient : McOrientType := (Angle1:=0,Angle2:=180,Angle3:=0);
END_VAR
(* Synchronizacja PLC ze ST Motion *)
VAR
	RTrigExecute : r_trig;
	ExecuteImpulse : BOOL;
	RTrigSTMotionDone : r_trig;
	STMotionDoneImpulse : BOOL;
END_VAR
(* Obs³uga stosów warcabów *)
VAR CONSTANT
	BlackPileXOffs : REAL := 50;
	WhitePileXOffs : REAL := -50;
	PileZOffs : REAL := 26;
	PileHeight : USINT := 4;
END_VAR
VAR
	BlackPileCnt : USINT;
	WhitePileCnt : USINT;
	PileCalculatedOffs : McPosType;
END_VAR
(* Rêczne sterowanie kartezjañskie *)
VAR
	JogXPos : BOOL;
	JogXNeg : BOOL;
	JogYPos : BOOL;
	JogYNeg : BOOL;
	JogZPos : BOOL;
	JogZNeg : BOOL;
	JogCartesianSpeed : REAL;
END_VAR
(* Rêczne sterowanie osiami robota *)
VAR
	JogJointPos0 : BOOL;
	JogJointNeg0 : BOOL;
	JogJointPos1 : BOOL;
	JogJointNeg1 : BOOL;
	JogJointPos2 : BOOL;
	JogJointNeg2 : BOOL;
	JogJointPos3 : BOOL;
	JogJointNeg3 : BOOL;
	JogJointPos4 : BOOL;
	JogJointNeg4 : BOOL;
	JogJointPos5 : BOOL;
	JogJointNeg5 : BOOL;
	JogJointAny : BOOL;
	JogJointSpeed : REAL;
END_VAR
