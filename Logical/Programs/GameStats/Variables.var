VAR
	WinOrLose : BOOL; (*True - wygrana, False - przegrana*)
	EndGame : BOOL; (*True - Koniec gry, False - gra wciaz trwa*)
	DeadWhitePiece : INT; (*Zbite biale pionki*)
	DeadBlackPiece : INT; (*Zbite czarne pionki*)
	MoveCount : INT; (*Ilosc ruchow*)
	i : USINT; (*zmienna do for*)
	j : USINT; (*zmienna do for*)
	whiteOnBoard : INT; (*ilosc bialych pionkow na planszy*)
	blackOnBoard : INT; (*ilosc czarnych pionkow na planszy*)
	gBoardLast : ARRAY[1..8,1..8] OF USINT; (*poprzedni stan planszy*)
	firstScan : BOOL := TRUE; (*pierwszy cykl - tylko zapamietaj plansze*)
	fromRow : USINT; (*wiersz startowy ruchu*)
	fromCol : USINT; (*kolumna startowa ruchu*)
	toRow : USINT; (*wiersz docelowy ruchu*)
	toCol : USINT; (*kolumna docelowa ruchu*)
	capCount : USINT; (*ilosc zbic w ruchu*)
	movedColor : USINT; (*1 - bialy, 2 - czarny*)
	cellColor : USINT; (*kolor pionka na polu*)
	pChar : REFERENCE TO USINT; (*wskaznik do budowy stringu*)
	LastMove : STRING[20]; (*ostatni wykryty ruch*)
	MoveHistory : ARRAY[1..4] OF STRING[20]; (*[1] najnowszy, [4] najstarszy*)
END_VAR
