                <Method xsi:type="widgets.brease.Ellipse.Action.SetEnable" value="true" />
              </Target>
            </Action>
          </Step>
          <Step order="2">
            <Action>
              <Target xsi:type="widgets.brease.Ellipse.Action" contentRefId="PlayContent" widgetRefId="WhiteC1">
                <Method xsi:type="widgets.brease.Ellipse.Action.SetEnable" value="true" />
              </Target>
            </Action>
          </Step>
        </Sequence>
      </EventHandler>
      <EventHandler condition="newValue = 0">
        <Sequence>
          <Step order="0">
            <Action>
              <Target xsi:type="widgets.brease.Ellipse.Action" contentRefId="PlayContent" widgetRefId="WhiteA1">
                <Method xsi:type="widgets.brease.Ellipse.Action.SetEnable" value="false" />
              </Target>
            </Action>
          </Step>
          <Step order="2">
            <Action>
              <Target xsi:type="widgets.brease.Ellipse.Action" contentRefId="PlayContent" widgetRefId="WhiteC1">
                <Method xsi:type="widgets.brease.Ellipse.Action.SetEnable" value="false" />
              </Target>
            </Action>
          </Step>
        </Sequence>
      </EventHandler>
    </EventBinding>
