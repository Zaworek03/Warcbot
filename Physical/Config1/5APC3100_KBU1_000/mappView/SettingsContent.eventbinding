<?xml version="1.0" encoding="utf-8"?>
<EventBindingSet id="SettingsContent" xmlns="http://www.br-automation.com/iat2014/eventbinding/v2" xmlns:types="http://www.br-automation.com/iat2015/widgetTypes/v2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Bindings>
    <EventBinding id="SettingsContent.BtnUserAdd.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="SettingsContent" widgetRefId="BtnUserAdd" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="widgets.brease.UserList.Action" contentRefId="SettingsContent" widgetRefId="UserList">
            <Method xsi:type="widgets.brease.UserList.Action.OpenAddUserDialog" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="SettingsContent.BtnUserRemove.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="SettingsContent" widgetRefId="BtnUserRemove" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="widgets.brease.UserList.Action" contentRefId="SettingsContent" widgetRefId="UserList">
            <Method xsi:type="widgets.brease.UserList.Action.DeleteUser" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="SettingsContent.BtnUserModify.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="SettingsContent" widgetRefId="BtnUserModify" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="widgets.brease.UserList.Action" contentRefId="SettingsContent" widgetRefId="UserList">
            <Method xsi:type="widgets.brease.UserList.Action.OpenModifyUserDialog" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="SettingsContent.Button1.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="SettingsContent" widgetRefId="Button1" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="opcUa.NodeAction" refId="::SaveGame:UIConnect.Recipe.Save">
            <Method xsi:type="opcUa.NodeAction.SetValueBool" value="true" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="SettingsContent.Button2.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="SettingsContent" widgetRefId="Button2" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="opcUa.NodeAction" refId="::SaveGame:UIConnect.Recipe.Load">
            <Method xsi:type="opcUa.NodeAction.SetValueBool" value="true" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
  </Bindings>
</EventBindingSet>