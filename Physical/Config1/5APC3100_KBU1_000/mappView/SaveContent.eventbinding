<?xml version="1.0" encoding="utf-8"?>
<EventBindingSet id="SaveContent" xmlns="http://www.br-automation.com/iat2014/eventbinding/v2" xmlns:types="http://www.br-automation.com/iat2015/widgetTypes/v2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Bindings>
    <EventBinding id="SaveContent.BtnNewSave.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="SaveContent" widgetRefId="BtnNewSave" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.OpenDialog" dialogId="NewSaveDialog" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler>
        <Action>
          <Target xsi:type="opcUa.NodeAction" refId="::SaveGame:NSDialogOpen">
            <Method xsi:type="opcUa.NodeAction.SetValueBool" value="true" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="SaveContent.BtnLoad.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="SaveContent" widgetRefId="BtnLoad" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="opcUa.NodeAction" refId="::SaveGame:Load">
            <Method xsi:type="opcUa.NodeAction.SetValueBool" value="true" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="SaveContent.BtnDelete.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="SaveContent" widgetRefId="BtnDelete" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.OpenDialog" dialogId="DeleteConfDialog" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
  </Bindings>
</EventBindingSet>