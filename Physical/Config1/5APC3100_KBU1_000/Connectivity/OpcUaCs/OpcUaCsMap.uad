<?xml version="1.0" encoding="utf-8"?>
<?AutomationStudio FileVersion="6.0"?>
<OpcUaSource FileVersion="10">
  <Aliases>
    <ACLAliases />
    <EURangeViolationAliases />
    <EURangesAliases />
    <EngineeringUnitAliases />
  </Aliases>
  <Module Name="&lt;Default&gt;">
    <GlobalVariables Name="Global Variables">
      <Variable Name="gPickPiece" RecursiveEnable="2" />
      <Variable Name="gEnableMove" RecursiveEnable="2" />
      <Variable Name="gPickMove" RecursiveEnable="2" />
      <Variable Name="gBoardActual" RecursiveEnable="2" />
      <Variable Name="gGameRound" />
      <Variable Name="gPlayerColor" />
      <Variable Name="gDifficultyLevel" />
      <Variable Name="gStart" />
      <Variable Name="gEnablePiece" RecursiveEnable="2" />
      <Variable Name="gESTOP" />
      <Variable Name="gMotionInterface">
        <Variable Name="RequestManualMode" />
        <Variable Name="Manual">
          <Variable Name="Joint">
            <Variable Name="JogPos0" />
            <Variable Name="JogPos1" />
            <Variable Name="JogPos2" />
            <Variable Name="JogPos3" />
            <Variable Name="JogPos4" />
            <Variable Name="JogPos5" />
            <Variable Name="JogNeg0" />
            <Variable Name="JogNeg1" />
            <Variable Name="JogNeg2" />
            <Variable Name="JogNeg3" />
            <Variable Name="JogNeg4" />
            <Variable Name="JogNeg5" />
          </Variable>
          <Variable Name="Cartesian">
            <Variable Name="JogXPos" />
            <Variable Name="JogXNeg" />
            <Variable Name="JogYPos" />
            <Variable Name="JogYNeg" />
            <Variable Name="JogZPos" />
            <Variable Name="JogZNeg" />
          </Variable>
        </Variable>
      </Variable>
    </GlobalVariables>
    <Task Name="FixAxisDir">
      <Variable Name="AxisQ1Pos" />
      <Variable Name="AxisQ3Pos" />
      <Variable Name="AxisQ2Pos" />
      <Variable Name="AxisQ4Pos" />
      <Variable Name="AxisQ5Pos" />
      <Variable Name="AxisQ6Pos" />
    </Task>
    <Task Name="SaveGame">
      <Variable Name="UIConnect">
        <Variable Name="Recipe">
          <Variable Name="List">
            <Variable Name="Names" />
            <Variable Name="SelectedIndex" />
            <Variable Name="LastModified" />
          </Variable>
          <Variable Name="Refresh" />
        </Variable>
        <Variable Name="MessageBox">
          <Variable Name="ErrorNumber" />
          <Variable Name="Confirm" />
          <Variable Name="Cancel" />
          <Variable Name="LayerStatus" />
        </Variable>
      </Variable>
      <Variable Name="SaveFileName" />
      <Variable Name="NewSave" />
      <Variable Name="InvSavFileName" />
      <Variable Name="Saved" />
      <Variable Name="NSDialogOpen" />
      <Variable Name="Load" />
      <Variable Name="DeleteSave" />
      <Variable Name="CurrentFileName" />
      <Variable Name="IndexOOR" />
      <Variable Name="NIndexOOR" />
    </Task>
    <Task Name="AlarmHisto">
      <Variable Name="AHExport" />
      <Variable Name="MpAlarmXHistory_0">
        <Variable Name="Info">
          <Variable Name="GeneratedFileName" />
        </Variable>
      </Variable>
      <Variable Name="OpenExportDialog" />
    </Task>
    <Task Name="GameStats">
      <Variable Name="EndGame" />
      <Variable Name="WinOrLose" />
      <Variable Name="MoveCount" />
      <Variable Name="DeadBlackPiece" />
      <Variable Name="DeadWhitePiece" />
      <Variable Name="MoveHistory" RecursiveEnable="2" />
    </Task>
  </Module>
</OpcUaSource>